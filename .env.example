# Onde o SQLite fica salvo (padrão: data/mare.db)
# DB_PATH=data/mare.db

# Contas: depois da primeira conta, o cadastro fica fechado. Use 1 para permitir novos cadastros.
# CADASTRO_ABERTO=0

# Confirmação de e-mail: com 1, a conta só é criada depois que a pessoa digita o código de 6 números enviado por SMTP.
# Com 1, SMTP_HOST e o remetente são obrigatórios; sem eles o servidor nem sobe.
CONFIRMAR_EMAIL=1

# Brevo: Settings > SMTP & API > aba SMTP. Copie de lá o "Login" e gere uma "SMTP key".
# SMTP_USUARIO é o Login mostrado nessa página (pode ser o e-mail da conta ou algo como 123abc@smtp-brevo.com).
# SMTP_SENHA é a SMTP key (começa com xsmtpsib-); não serve a senha da conta nem uma API key. Fica só no .env.
# SMTP_REMETENTE precisa ser um remetente verificado no Brevo (Settings > Senders, domains & dedicated IPs).
# Se a porta 587 estiver bloqueada, use SMTP_PORTA=2525. Porta 465 usa SMTP_SEGURANCA=ssl.
# SMTP_SEGURANCA aceita starttls (padrão), ssl ou nenhuma (esta só vale se o host for localhost).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORTA=587
SMTP_SEGURANCA=starttls
SMTP_USUARIO=SEU_LOGIN_SMTP_DO_BREVO
SMTP_SENHA=SUA_SMTP_KEY_DO_BREVO
SMTP_REMETENTE=SEU_REMETENTE_VERIFICADO

# Minutos de validade do código (padrão: 10) e segundos entre um envio e outro (padrão: 60).
# CODIGO_MINUTOS=10
# REENVIO_SEGUNDOS=60

# Dias de validade da sessão, renovada a cada uso (padrão: 14).
# SESSAO_DIAS=14
# Custo do scrypt da senha, como potência de 2 (padrão: 17, o mínimo recomendado pelo OWASP). Só baixe em testes.
# SCRYPT_LOG_N=17
# Envios de arquivo por minuto, por pessoa (padrão: 10).
# UPLOADS_POR_MINUTO=10

# Tamanho máximo do arquivo importado, em MB (padrão: 5)
# MAX_UPLOAD_MB=5
# Máximo de lançamentos por arquivo (padrão: 3000). Protege contra arquivos gigantes.
# MAX_LINHAS=3000
# Hosts aceitos no cabeçalho Host, separados por vírgula (padrão: localhost, 127.0.0.1, [::1]).
# Se acessar por outro nome ou IP da rede, liste aqui. Barra ataques de DNS rebinding.
# ALLOWED_HOSTS=meu-pc.local,192.168.0.10
